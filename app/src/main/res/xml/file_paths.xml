<?xml version="1.0" encoding="utf-8"?>
<!-- Only exported chats and built APKs are shared with other apps. -->
<paths>
    <cache-path name="exports" path="exports/" />
    <!-- APKs built in Build mode, opened with Android's installer. -->
    <cache-path name="apks" path="apks/" />
    <!-- Movies made in the Movie Maker, opened or shared. -->
    <cache-path name="movies" path="movies/" />
    <!-- Arin's one folder (Android/data/com.arin.app/files/Arin): open, share or install what's in it. -->
    <external-files-path name="arin" path="Arin/" />
</paths>
